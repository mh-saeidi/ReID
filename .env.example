# Optional environment overrides.
# Values are substituted into the YAML configuration via ${VAR} / ${VAR:-default}.
#
#   models:
#     detector: "${REID_DETECTOR_MODEL:-models/yolo26n.pt}"

# Model locations
REID_DETECTOR_MODEL=models/yolo26n.pt
REID_REID_MODEL=models/yolo26n-reid.onnx

# Compute
REID_DEVICE=auto

# Recognition threshold -- calibrate per deployment, do not copy between sites.
REID_THRESHOLD=0.55

# Output root
REID_OUTPUT_DIR=data/output

# Ultralytics: keep everything local and offline-friendly.
YOLO_VERBOSE=false
# ULTRALYTICS_OFFLINE=1
